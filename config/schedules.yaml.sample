# Scheduled Jobs
#
# SETUP: cp schedules.yaml.sample schedules.yaml
#
# Cron format: minute hour day month weekday
# Examples:
#   "0 2 * * *"   = Daily at 2:00 AM
#   "0 */6 * * *" = Every 6 hours
#   "0 3 * * 1"   = Mondays at 3:00 AM

schedules:
  de-daily-update:
    enabled: true
    parliament: DE
    cron: "0 2 * * *"
    stages: [download, parse, merge, nel, align]
    description: "Daily Bundestag update at 2 AM"
    publish_on_success: true

  # de-weekly-ner:
  #   enabled: false
  #   parliament: DE
  #   cron: "0 4 * * 0"
  #   stages: [ner]
  #   force: true
  #   description: "Weekly NER extraction"
