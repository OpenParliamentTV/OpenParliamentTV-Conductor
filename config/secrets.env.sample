# OpenParliamentTV Import Manager - Secrets
#
# SETUP: cp secrets.env.sample secrets.env
#        Then fill in values below
#
# Generate JWT_SECRET: openssl rand -hex 32

# ===================
# GitHub OAuth (Required)
# ===================
# Create at: https://github.com/settings/developers
# Callback URL: https://your-domain.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===================
# JWT Authentication (Required)
# ===================
JWT_SECRET=

# ===================
# Application URL (Required)
# ===================
BASE_URL=https://your-domain.com

# ===================
# NER Service (Optional)
# ===================
# Leave empty to disable NER
# Use http://entity-fishing:8090 if running with --profile ner
# Or specify external endpoint
NER_API_ENDPOINT=

# ===================
# Slack Notifications (Optional)
# ===================
# Create webhook at: https://api.slack.com/apps
# Leave empty to disable notifications
SLACK_WEBHOOK_URL=

# ===================
# Git identity for the publish step
# ===================
# Threaded into `git -c user.name=... -c user.email=...` per commit — no global
# git config mutation. Used only by Conductor's publish step on Data repos.
GIT_USER_NAME=Conductor Bot
GIT_USER_EMAIL=conductor@example.com

# ===================
# SSH keys for git operations against Data repos
# ===================
# Path on host containing the SSH key Conductor uses to git pull/push.
# Default: ./config/ssh — created by setup.sh, dedicated per-deployment key.
# The public key (config/ssh/id_ed25519.pub) must be added as a deploy key
# with WRITE access on each Data repo.
# Override only if you need to use a different keystore (e.g., legacy ~/.ssh).
# SSH_KEY_DIR=~/.ssh

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
