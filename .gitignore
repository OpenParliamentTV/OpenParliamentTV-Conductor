optv.config
# Ignore extracted repositories
OpenParliamentTV-*/

# Mac OS X
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory

# Logs
logs/
_logs/
*.log
!logs/.gitkeep

# Runtime data
pids
*.pid
*.seed
.idea/
_planning/

# Media files
*.m4v
*.mp4
*.webm
*.mov
*.mpg
*.mp3

# ===================
# Configuration (real files, not samples)
# ===================
config/secrets.env
config/parliaments.yaml
config/users.yaml
config/schedules.yaml
config/notifications.yaml
config/ssh/

# ===================
# SSL Certificates
# ===================
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt
!nginx/ssl/.gitkeep
nginx/config/*
!nginx/config/.gitkeep

# ===================
# Runtime State
# ===================
status/
!status/.gitkeep
.self-update.lock

# ===================
# Data Directory (single mount)
# ===================
data/

# ===================
# Local Docker overrides
# ===================
docker-compose.override.*

# ===================
# Python
# ===================
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
